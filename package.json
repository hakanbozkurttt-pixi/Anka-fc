{
  "name": "anka-fc",
  "private": true,
  "version": "0.1.0",
  "description": "Mama takip uygulaması: müşteri telefon uygulaması, hastane yönetim paneli ve Supabase arka planı.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "mobile": "npm run start --workspace mobile",
    "admin": "npm run dev --workspace admin",
    "admin:build": "npm run build --workspace admin",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "admin:create": "node --env-file-if-exists=.env scripts/create-admin.mjs",
    "db:test": "node --env-file-if-exists=.env scripts/test-security.mjs"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.119.2",
    "supabase": "^3.2.0"
  }
}
