# Kök klasör ortam değişkenleri: YALNIZCA bilgisayarınızda çalışan yardımcı betikler içindir
# (npm run admin:create, npm run db:test).
#
# Yerel geliştirmede bu dosyaya GEREK YOKTUR: betikler bilgileri çalışan yerel
# Supabase'den ("npm run db:status") kendileri okur.
#
# İleride bulut Supabase projesi için kullanılırsa ".env" adıyla kopyalayın.
# SUPABASE_SECRET_KEY tam yetkili gizli anahtardır: git'e, telefon uygulamasına
# veya yönetim paneline ASLA konmaz, kimseyle paylaşılmaz.

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=buraya-publishable-anahtar
SUPABASE_SECRET_KEY=buraya-secret-anahtar
