# Müşteri telefon uygulaması ortam değişkenleri.
# Bu dosyayı ".env" adıyla kopyalayın ve değerleri doldurun. ".env" git'e eklenmez.
#
# Yerel geliştirme: kök klasörde "npm run db:start" çalıştırın, ardından
# "npm run db:status" çıktısındaki "API URL" ve "Publishable key" değerlerini girin.
#
# ÖNEMLİ (gerçek telefonla deneme): Telefon "127.0.0.1" adresiyle bilgisayarınıza
# ulaşamaz. Telefon ve bilgisayar aynı Wi-Fi ağındayken, adresi bilgisayarınızın
# yerel IP adresiyle değiştirin (örnek: http://192.168.1.20:54321).
#
# DİKKAT: EXPO_PUBLIC_ ile başlayan değerler uygulamanın içine gömülür.
# Buraya yalnızca "publishable" (eski adıyla "anon") anahtar yazılır;
# "secret" / "service_role" anahtar asla yazılmaz.

EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=buraya-publishable-anahtar
