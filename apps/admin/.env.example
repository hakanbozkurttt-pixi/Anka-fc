# Hastane yönetim paneli ortam değişkenleri.
# Bu dosyayı ".env" adıyla kopyalayın ve değerleri doldurun. ".env" git'e eklenmez.
#
# Yerel geliştirme: kök klasörde "npm run db:start" çalıştırın, ardından
# "npm run db:status" çıktısındaki "API URL" ve "Publishable key" değerlerini girin.
#
# DİKKAT: Buraya yalnızca "publishable" (eski adıyla "anon") anahtar yazılır.
# "secret" / "service_role" anahtar tarayıcıya giden koda asla konmaz.

VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=buraya-publishable-anahtar
